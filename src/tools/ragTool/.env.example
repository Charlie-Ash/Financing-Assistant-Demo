# Copy this file to .env (in this same folder) and edit as needed.
# Every value shown here is the built-in default -- uncomment and change
# only what you need to override. See tools/ragTool/config.py for validation
# rules (ranges, etc).

# Folder of documents to ingest: laws/*.json, policies/*.md and any *.pdf.
# Relative paths are resolved against the project root.
# RAG_DATA_DIR=data/regulations
# Base collection name; the embedding model is appended automatically
# (e.g. regulations__bge-m3), so changing RAG_EMBEDDING_MODEL rebuilds the index.
# Changing the documents does NOT rebuild it: delete src/tools/ragTool/qdrant_db.
# RAG_COLLECTION_NAME=regulations
# Simplified->Traditional safety net. chars (default here) never alters valid
# Traditional text, so quoted laws stay exact; s2twp also converts vocabulary
# but rewrites official characters (占 -> 佔, 致 -> 緻).
# LLM_TRADITIONAL_MODE=chars
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Where the embedding + reranker run: cuda (~2.7 GiB VRAM, budgeted) or cpu.
# RAG_EMBED_DEVICE=cuda
# Vector-search candidates, and how many survive reranking into the prompt.
# RAG_RETRIEVE_TOP_K=20
# RAG_RERANK_TOP_N=4

# Standalone A2A server bind address/port.
# RAG_A2A_HOST=0.0.0.0
# RAG_A2A_PORT=8001

# Shared LLM server (started with `python -m llm.serve`).
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_SERVED_NAME=hotai-llm
# LLM_TIMEOUT_SECONDS=120
# How long to wait at startup for the LLM server to finish loading.
# LLM_STARTUP_WAIT_SECONDS=300

# --- Gemini API instead of the local server (see README "Using the Gemini API") ---
# vllm = local server above; gemini = Google's hosted API (needs GEMINI_API_KEY).
# LLM_PROVIDER=vllm
# Exact model id from Google AI Studio (avoid -preview / -latest ids). The
# default is gemini-3.5-flash-lite; the fuller Flash model is suggested here
# since this agent writes the grounded answers.
# LLM_GEMINI_MODEL=gemini-3.5-flash
# Lowest thinking level the model accepts: gemini-3.5-flash accepts none;
# gemini-3.5-flash-lite needs minimal.
# LLM_REASONING_EFFORT=none
# API key from aistudio.google.com -> API keys. This file is git-ignored; never
# put the key in .env.example.
# GEMINI_API_KEY=
