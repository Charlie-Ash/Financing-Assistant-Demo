# Copy this file to .env (in this same folder) and edit as needed.
# Every value shown here is the built-in default -- uncomment and change
# only what you need to override. See web/config.py for validation rules.

# Address the web interface listens on. Keep 127.0.0.1 until the system has
# a login (Phase 5): reach it from another computer through an SSH tunnel or
# VS Code port forwarding instead of exposing it on the network.
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
