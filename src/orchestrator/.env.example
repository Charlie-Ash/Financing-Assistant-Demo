# Copy this file to .env (in this same folder) and edit as needed.
# Every value shown here is the built-in default -- uncomment and change
# only what you need to override. See orchestrator/config.py for validation
# rules (ranges, etc).

# Remote A2A agents to discover at startup: "name@url,name@url,..."
# REMOTE_AGENTS=rag@http://localhost:8001,credit_lookup@http://localhost:8002
# Agents whose successful results are relayed to the user verbatim.
# REMOTE_AGENTS_VERBATIM=rag,credit_lookup
# REMOTE_AGENT_TIMEOUT_SECONDS=180

# Defaults to <project root>/data/checkpoints/checkpoints.db; use an absolute path to override.
# CHECKPOINT_DB_PATH=/abs/path/to/checkpoints.db

# Shared LLM server (started with `python -m llm.serve`).
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_SERVED_NAME=hotai-llm
# LLM_TIMEOUT_SECONDS=120
# How long to wait at startup for the LLM server to finish loading.
# LLM_STARTUP_WAIT_SECONDS=300

# --- Gemini API instead of the local server (see README "Using the Gemini API") ---
# vllm = local server above; gemini = Google's hosted API (needs GEMINI_API_KEY).
# LLM_PROVIDER=vllm
# Exact model id from Google AI Studio (avoid -preview / -latest ids).
# LLM_GEMINI_MODEL=gemini-3.5-flash-lite
# Lowest thinking level the model accepts: gemini-3.5-flash-lite needs minimal;
# gemini-3.1-flash-lite and gemini-3.5-flash accept none.
# LLM_REASONING_EFFORT=minimal
# API key from aistudio.google.com -> API keys. This file is git-ignored; never
# put the key in .env.example.
# GEMINI_API_KEY=
