# Copy this file to .env (in this same folder) and edit as needed.
# Every value shown here is the built-in default -- uncomment and change
# only what you need to override. See orchestrator/config.py for validation
# rules (ranges, etc).

# "name@url,name@url,..." -- which remote A2A agents to discover at startup.
# REMOTE_AGENTS=rag@http://localhost:8001,actions@http://localhost:8002

# Comma-separated agent names whose successful results are relayed to the
# user verbatim instead of being composed into a reply.
# REMOTE_AGENTS_VERBATIM=rag

# Where the persistent LangGraph checkpointer writes conversation state.
# CHECKPOINT_DB_PATH=./data/checkpoints/checkpoints.db

# How long (seconds) the orchestrator's A2A client waits for a remote
# agent's response before giving up.
# REMOTE_AGENT_TIMEOUT_SECONDS=180

# This process's own vLLM engine.
# ORCHESTRATOR_LLM_MODEL=google/gemma-4-E4B-it
# ORCHESTRATOR_GPU_MEMORY_UTILIZATION=0.6
# ORCHESTRATOR_MAX_MODEL_LEN=4096
