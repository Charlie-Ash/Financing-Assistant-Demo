# Copy this file to .env (in this same folder) and edit as needed.
# Every value shown here is the built-in default -- uncomment and change
# only what you need to override. Read by `python -m llm.serve`; see
# llm/settings.py for validation rules and llm/profiles.py for the models.

# Which model to serve: qwen3-14b-fp8, qwen3-8b-fp8, or llama3-taiwan-8b-fp8
# LLM_PROFILE=qwen3-14b-fp8

# Name the model is served under. Must match LLM_SERVED_NAME in every agent's .env.
# LLM_SERVED_NAME=hotai-llm

# LLM_HOST=0.0.0.0
# LLM_PORT=8000

# Whole-card fraction for weights + CUDA graphs + KV cache (0 < x <= 1).
# ~1.3 GiB fixed overhead and the RAG process's embedding/reranker (~2.7 GiB
# on CUDA) sit outside this. 0.77 leaves ~3 GiB margin on an RTX 5090 with
# qwen3-14b-fp8; lower it if the RAG agent fails to load its models.
# LLM_GPU_MEMORY_UTILIZATION=0.77

# Overrides the profile's own max_model_len.
# LLM_MAX_MODEL_LEN=16384
