__pycache__/
.__pycache__/
*.pyc

# RAG tool's local Qdrant vector store
qdrant_db/

# Credit Lookup agent's synthetic database (rebuilt from seed_db.py) and
# its audit log of who looked up whom
data/credit/

# Eval run outputs (see evals/)
evals/results/

# Generated graph diagram PNGs (see tests/graph_visualization/)
tests/graph_visualization/output/
